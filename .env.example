SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
ADMIN_EMAILS=

# Support/resource-report attachments. Production fails closed unless a real
# scanner is configured. Development defaults to the EICAR-only test scanner.
DP_ATTACHMENT_SCANNER=cloudmersive
CLOUDMERSIVE_API_KEY=

# Private question-bank assets. R2 is preferred; set this to supabase only
# when a dedicated private Supabase Storage bucket has been provisioned.
QUESTION_BANK_STORAGE_PROVIDER=r2
R2_QUESTION_BANK_BUCKET=
QUESTION_BANK_SUPABASE_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional endpoint override, for example an account-specific S3 endpoint.
R2_ENDPOINT=
